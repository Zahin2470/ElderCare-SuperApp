# Copy to .env.local for local overrides. Vite only exposes variables prefixed VITE_ to the browser.

# Override the API base path (defaults to '/api', proxied to the backend by Vite in dev — see vite.config.ts).
# VITE_API_BASE=/api

# Browser error monitoring (optional). Without it, nothing is sent anywhere and no extra code is even
# downloaded — the error-reporting SDK is loaded on demand only when this is set.
VITE_SENTRY_DSN=
