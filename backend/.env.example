# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Behind nginx / a load balancer set this to 1 so rate limits and audit logs see the real client IP.
TRUST_PROXY=0
# Comma-separated list of browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Asia/Dhaka
# Run pending SQL migrations on boot. Set to false if you run `npm run migrate` as a separate deploy step.
AUTO_MIGRATE=true

# ── Database (PostgreSQL 14+) ──────────────────────────
DATABASE_URL=postgres://eldercare:eldercare_dev@127.0.0.1:5432/eldercare

# ── Secrets — REQUIRED in production (the server refuses to start with the dev defaults) ──
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── File storage for Care360 uploads (local disk; swap for S3 in production) ──
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# ── AI (optional) ──────────────────────────────────────
# Without a key every AI feature still works using rule-based fallbacks ("basic mode").
# The key stays on the server; it is never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_DAILY_MESSAGE_LIMIT=30
AI_TIMEOUT_MS=25000

# ── TeleHealth video visits (optional) ─────────────────
# Base URL of a video-meeting host, ideally self-hosted (e.g. Jitsi Meet) because consultations are private.
# Unset = the app tells users video is not set up yet. Room names are unguessable per appointment.
VIDEO_BASE_URL=

# ── Safety copy shown by the assistant for emergencies ─
EMERGENCY_NUMBER=999
HEALTH_HOTLINE=16263
